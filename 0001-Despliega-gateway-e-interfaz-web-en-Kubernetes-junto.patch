--- /dev/null
+++ b/demo/frontend/k8s/frontend.yaml
@@ -0,0 +1,77 @@
+# Interfaz web (React compilado, servido por nginx). nginx reenvía /graphql y /api/
+# al Service `gateway` del mismo namespace, así el navegador solo habla con un origen.
+apiVersion: apps/v1
+kind: Deployment
+metadata:
+  name: frontend
+  labels:
+    app.kubernetes.io/name: frontend
+    app.kubernetes.io/part-of: chat
+spec:
+  replicas: 1
+  revisionHistoryLimit: 5
+  selector:
+    matchLabels:
+      app.kubernetes.io/name: frontend
+  strategy:
+    type: RollingUpdate
+    rollingUpdate: {maxUnavailable: 0, maxSurge: 1}
+  template:
+    metadata:
+      labels:
+        app.kubernetes.io/name: frontend
+        app.kubernetes.io/part-of: chat
+    spec:
+      securityContext:
+        runAsNonRoot: true
+        runAsUser: 101    # usuario nginx de nginx-unprivileged
+        runAsGroup: 101
+        seccompProfile:
+          type: RuntimeDefault
+      containers:
+        - name: frontend
+          image: frontend   # el overlay lo reemplaza por la imagen publicada por el CI
+          ports:
+            - name: http
+              containerPort: 8080
+          resources:
+            requests: {cpu: 25m, memory: 32Mi}
+            limits: {cpu: 100m, memory: 64Mi}
+          # /healthz lo responde nginx mismo: el frontend sigue "vivo" aunque el
+          # gateway caiga (la interfaz muestra el error en vez de desaparecer).
+          livenessProbe:
+            httpGet: {path: /healthz, port: http}
+            periodSeconds: 10
+            failureThreshold: 3
+          readinessProbe:
+            httpGet: {path: /healthz, port: http}
+            periodSeconds: 5
+            failureThreshold: 2
+          securityContext:
+            allowPrivilegeEscalation: false
+            readOnlyRootFilesystem: true
+            capabilities:
+              drop: ["ALL"]
+          volumeMounts:
+            # nginx escribe su pid y cachés temporales en /tmp.
+            - name: tmp
+              mountPath: /tmp
+      volumes:
+        - name: tmp
+          emptyDir: {}
+---
+apiVersion: v1
+kind: Service
+metadata:
+  name: frontend
+  labels:
+    app.kubernetes.io/name: frontend
+    app.kubernetes.io/part-of: chat
+spec:
+  type: ClusterIP
+  selector:
+    app.kubernetes.io/name: frontend
+  ports:
+    - name: http
+      port: 8080
+      targetPort: http
diff --git a/demo/frontend/k8s/ingress/ingress.yaml b/demo/frontend/k8s/ingress/ingress.yaml
new file mode 100644
index 0000000..892b657
--- /dev/null
+++ b/demo/frontend/k8s/ingress/ingress.yaml
@@ -0,0 +1,27 @@
+# Entrada desde fuera del namespace (navegador y otros grupos). La NetworkPolicy
+# del curso solo deja entrar tráfico del mismo namespace, `infraestructura` (donde
+# vive el controlador de Ingress) y `servicios-base`; por eso lo que deba usarse
+# desde afuera pasa por aquí.
+#   /         -> interfaz web (nginx), que a su vez reenvía /graphql y /api/ al gateway
+# HOST_PLACEHOLDER y CLASS_PLACEHOLDER los reemplaza el CI (vars.INGRESS_HOST y
+# vars.INGRESS_CLASS) o se editan a mano antes de `kubectl apply -k`.
+apiVersion: networking.k8s.io/v1
+kind: Ingress
+metadata:
+  name: frontend
+  labels:
+    app.kubernetes.io/name: frontend
+    app.kubernetes.io/part-of: chat
+spec:
+  ingressClassName: CLASS_PLACEHOLDER
+  rules:
+    - host: HOST_PLACEHOLDER
+      http:
+        paths:
+          - path: /
+            pathType: Prefix
+            backend:
+              service:
+                name: frontend
+                port:
+                  name: http
