# Plantilla. Copiar a core.env (ignorado por git) y completar con las URLs internas
# del chat base que entrega el curso. En el CI, core.env se arma desde los secrets
# OZY_USERS_URL, OZY_CHANNELS_URL y OZY_MESSAGES_URL: las URLs no quedan en el repo.
USERS_URL=http://<servicio-users>:<puerto>
CHANNELS_URL=http://<servicio-channels>:<puerto>
MESSAGES_URL=http://<servicio-messages>:<puerto>
# Opcionales (API Gateway): capacidades de otros grupos. Sin ellas, el gateway sigue
# funcionando y solo esas secciones de la interfaz muestran el servicio como caído.
# SEARCH_URL=http://<controlador-ingress>:<puerto>
# SEARCH_HOST=<host-del-ingress-de-busqueda>
# SUMMARIES_URL=http://<...>
