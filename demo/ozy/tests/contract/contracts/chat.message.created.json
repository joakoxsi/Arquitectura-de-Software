{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ozy/contracts/chat.message.created.json",
  "title": "Evento chat.message.created",
  "description": "Evento que publica `messages` en el exchange `chat` (routing key chat.message.created) al crear un mensaje. Ozy lo consume con la cola ozy.chat.message.created y lo mapea en app/acl.py. Solo se exigen los campos que Ozy usa; los demás se permiten (lector tolerante).",
  "x-provider": "messages",
  "x-consumer": "ozy",
  "x-version": "1",
  "type": "object",
  "required": ["type", "subject_id", "occurred_at", "data"],
  "properties": {
    "type": { "const": "chat.message.created" },
    "subject_id": { "type": "string", "minLength": 1 },
    "occurred_at": { "type": "string", "format": "date-time" },
    "data": {
      "type": "object",
      "required": ["id", "channel_id", "author_id", "content"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "channel_id": { "type": "string", "minLength": 1 },
        "author_id": { "type": "string", "minLength": 1 },
        "content": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "created_at": { "type": "string", "format": "date-time" }
      }
    }
  },
  "examples": [
    {
      "type": "chat.message.created",
      "subject_id": "6f1c2a90-3b5e-4d7a-9c11-2e8f0a4b7d55",
      "occurred_at": "2026-10-05T02:46:52.401550+00:00",
      "data": {
        "id": "6f1c2a90-3b5e-4d7a-9c11-2e8f0a4b7d55",
        "channel_id": "b2d4e6f8-1a3c-4e5f-8a9b-0c1d2e3f4a5b",
        "author_id": "9e8d7c6b-5a49-4382-9170-6f5e4d3c2b1a",
        "content": "Hice el PR pero el pipeline falló; revisen el KPI del ETL",
        "created_at": "2026-10-05T02:46:52.400000+00:00"
      }
    }
  ]
}
