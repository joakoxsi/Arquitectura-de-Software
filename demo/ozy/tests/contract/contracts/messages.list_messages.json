{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ozy/contracts/messages.list_messages.json",
  "title": "Respuesta de GET /api/v1/channels/{channel_id}/messages",
  "description": "Sin broker, el sincronizador de Ozy copia a su read-model los mensajes de cada canal pasando por la misma capa anticorrupción que el evento chat.message.created.",
  "x-provider": "messages",
  "x-consumer": "ozy",
  "x-version": "1",
  "x-request": { "method": "GET", "path": "/api/v1/channels/{channel_id}/messages" },
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "channel_id", "author_id", "content"],
    "properties": {
      "id": { "type": "string", "minLength": 1 },
      "channel_id": { "type": "string", "minLength": 1 },
      "author_id": { "type": "string", "minLength": 1 },
      "content": { "type": "string", "minLength": 1 },
      "created_at": { "type": "string", "format": "date-time" }
    }
  },
  "examples": [
    [
      {
        "id": "6f1c2a90-3b5e-4d7a-9c11-2e8f0a4b7d55",
